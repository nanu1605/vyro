<?xml version="1.0" encoding="utf-8"?>
<!--
  Clokrix MSI additions (referenced from tauri.conf.json → bundle.windows.wix):
  - ships the signed PawnIO installer and runs it silently, elevated, when PawnIO is missing or
    is a 1.x release. A PawnIO failure never fails the Clokrix install (Return="ignore"); the app
    then shows its "needs PawnIO" banner. PawnIO installs before the service starts.
  - installs PresentMon.exe (Intel, signed, MIT) beside the service, which runs it to measure
    the frame rate of the fullscreen game the app points it at.
  - installs clokrix-service.exe as "ClokrixService" (LocalSystem, automatic start, restarted on
    failure) and starts it without waiting: if it cannot start, the install still succeeds and
    the app falls back to reading unprivileged sensors itself, with a banner saying so.
  - removes the elevated "Vyro" logon task of versions before the service, on every install and
    uninstall (not on the uninstall half of an upgrade).
  - on uninstall, for the user running it, removes the per-user toast registration and the
    "Start with Windows" Run entry, under both names (Vyro's too, in case it was never carried
    over). Settings, alert rules and history (%ProgramData%\Clokrix and
    %APPDATA%\app.clokrix.monitor) are kept, as usual for user data.

  Vyro became Clokrix in 2.2 with the same upgrade code (tauri.conf.json), so this MSI replaces an
  installed Vyro as an upgrade: Windows removes Vyro (its service too) before installing this. The
  components have new GUIDs, as their folder and the service changed; the service and the app
  then carry Vyro's folders and settings over (clokrix_core::rename).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <Property Id="PAWNIO_VERSION">
      <RegistrySearch Id="PawnIOVersion" Root="HKLM" Win64="yes"
                      Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PawnIO"
                      Name="DisplayVersion" Type="raw" />
    </Property>

    <DirectoryRef Id="INSTALLDIR">
      <Directory Id="PawnIODir" Name="pawnio">
        <Component Id="PawnIOSetup" Guid="{324AB78E-31EE-4D0B-8649-8EE947016DB4}" Win64="yes">
          <File Id="PawnIOSetupExe" Name="PawnIO_setup.exe" KeyPath="yes"
                Source="$(sys.SOURCEFILEDIR)..\pawnio\PawnIO_setup.exe" />
        </Component>
      </Directory>

      <!-- Fetched by scripts/fetch-presentmon.ps1 (pinned SHA-256). -->
      <Component Id="PresentMon" Guid="{38B33DDC-7433-46C7-A545-2B6449F66F6B}" Win64="yes">
        <File Id="PresentMonExe" Name="PresentMon.exe" KeyPath="yes"
              Source="$(sys.SOURCEFILEDIR)..\presentmon\PresentMon.exe" />
      </Component>

      <!-- Built by tauri.conf.json → build.beforeBuildCommand. -->
      <Component Id="ClokrixService" Guid="{7A5FAB29-9EB4-49B2-8D8B-752FB00242F1}" Win64="yes">
        <File Id="ClokrixServiceExe" Name="clokrix-service.exe" KeyPath="yes"
              Source="$(sys.SOURCEFILEDIR)..\..\target\release\clokrix-service.exe" />
        <ServiceInstall Id="ClokrixServiceInstall" Name="ClokrixService"
                        DisplayName="Clokrix Sensor Service"
                        Description="Reads hardware sensors for Clokrix (CPU, board, memory and drive health) and keeps their history."
                        Type="ownProcess" Start="auto" ErrorControl="normal"
                        Account="LocalSystem" Vital="yes" />
        <!-- Stop and remove wait, so files are free before they are replaced or removed. -->
        <ServiceControl Id="ClokrixServiceStop" Name="ClokrixService" Stop="both" Remove="uninstall"
                        Wait="yes" />
        <!-- Start does not wait: a service that fails to start must not fail the install. -->
        <ServiceControl Id="ClokrixServiceStart" Name="ClokrixService" Start="install" Wait="no" />
      </Component>
    </DirectoryRef>

    <CustomAction Id="InstallPawnIO" FileKey="PawnIOSetupExe" ExeCommand="-install -silent"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- Restart after 5 s, 5 s and 60 s; the failure count resets after a day. -->
    <CustomAction Id="ConfigureServiceRecovery" Directory="INSTALLDIR"
                  ExeCommand="&quot;[SystemFolder]sc.exe&quot; failure ClokrixService reset= 86400 actions= restart/5000/restart/5000/restart/60000"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="RemoveLegacyAutostartTask" Directory="INSTALLDIR"
                  ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /Delete /TN &quot;Vyro&quot; /F"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- Impersonated, so HKCU is the uninstalling user's hive. -->
    <CustomAction Id="RemoveToastRegistration" Directory="INSTALLDIR"
                  ExeCommand="&quot;[SystemFolder]reg.exe&quot; delete &quot;HKCU\Software\Classes\AppUserModelId\app.clokrix.monitor&quot; /f"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="RemoveRunEntry" Directory="INSTALLDIR"
                  ExeCommand="&quot;[SystemFolder]reg.exe&quot; delete &quot;HKCU\Software\Microsoft\Windows\CurrentVersion\Run&quot; /v Clokrix /f"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <!-- Vyro's (before 2.2), when the app never ran after the upgrade to carry them over. -->
    <CustomAction Id="RemoveVyroToastRegistration" Directory="INSTALLDIR"
                  ExeCommand="&quot;[SystemFolder]reg.exe&quot; delete &quot;HKCU\Software\Classes\AppUserModelId\app.vyro.monitor&quot; /f"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="RemoveVyroRunEntry" Directory="INSTALLDIR"
                  ExeCommand="&quot;[SystemFolder]reg.exe&quot; delete &quot;HKCU\Software\Microsoft\Windows\CurrentVersion\Run&quot; /v Vyro /f"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="InstallPawnIO" After="InstallFiles">
        <![CDATA[NOT REMOVE AND (NOT PAWNIO_VERSION OR PAWNIO_VERSION << "1.")]]>
      </Custom>
      <Custom Action="ConfigureServiceRecovery" After="InstallServices">
        <![CDATA[NOT REMOVE]]>
      </Custom>
      <Custom Action="RemoveLegacyAutostartTask" Before="RemoveFiles">
        <![CDATA[NOT UPGRADINGPRODUCTCODE]]>
      </Custom>
      <Custom Action="RemoveToastRegistration" Before="RemoveFiles">
        <![CDATA[REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE]]>
      </Custom>
      <Custom Action="RemoveRunEntry" Before="RemoveFiles">
        <![CDATA[REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE]]>
      </Custom>
      <Custom Action="RemoveVyroToastRegistration" Before="RemoveFiles">
        <![CDATA[REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE]]>
      </Custom>
      <Custom Action="RemoveVyroRunEntry" Before="RemoveFiles">
        <![CDATA[REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE]]>
      </Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
