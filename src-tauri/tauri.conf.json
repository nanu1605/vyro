{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clokrix",
  "version": "2.1.0",
  "identifier": "app.clokrix.monitor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && cargo build --release -p clokrix-service",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clokrix",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 520,
        "backgroundColor": "#0a0d12",
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --in-process-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Clokrix",
    "copyright": "Clokrix contributors, MIT OR Apache-2.0",
    "license": "MIT OR Apache-2.0",
    "resources": {
      "../LICENSE-MIT": "LICENSE-MIT",
      "../LICENSE-APACHE": "LICENSE-APACHE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md",
      "../crates/clokrix-core/pawnio/COPYING": "COPYING-PawnIO-modules"
    },
    "windows": {
      "wix": {
        "upgradeCode": "4462867d-695d-5f78-bb13-262590559da4",
        "bannerPath": "wix/banner.bmp",
        "dialogImagePath": "wix/dialog.bmp",
        "fragmentPaths": [
          "wix/clokrix.wxs"
        ],
        "componentRefs": [
          "PawnIOSetup",
          "PresentMon",
          "ClokrixService"
        ]
      }
    }
  }
}
